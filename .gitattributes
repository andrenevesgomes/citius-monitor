# Normalise line endings across platforms.
* text=auto eol=crlf

# Windows scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF.
*.sh text eol=lf

# Treat these as binary (no diff/merge munging).
*.xlsx binary
*.png binary
*.jpg binary
*.pfx binary
